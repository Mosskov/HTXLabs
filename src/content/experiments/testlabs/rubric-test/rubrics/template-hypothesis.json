{
  "id": "template-hypothesis",
  "version": 2,
  "title": "Hypotese — sammenhæng mellem X og Y",
  "criteria": [
    {
      "id": "iv",
      "label": "Uafhængig variabel (X)",
      "hint": "Nævn X som den størrelse du varierer i forsøget.",
      "any": [
        {
          "kind": "semantic",
          "threshold": 0.85,
          "anchors": [
            "X er den uafhængige variabel",
            "jeg varierer X i forsøget",
            "den uafhængige størrelse er X",
            "jeg ændrer værdien af X for hver måling"
          ]
        },
        {
          "kind": "literal",
          "terms": ["uafhængig", "varierer"]
        }
      ],
      "misconceptions": [
        {
          "kind": "regex",
          "pattern": "(pendul|lod|svinger)",
          "flags": "iu",
          "hint": "Beskriv din konkrete X for dette forsøg — ikke et eksempel fra et andet forsøg."
        }
      ]
    },
    {
      "id": "dv",
      "label": "Afhængig variabel (Y)",
      "hint": "Nævn Y som den størrelse du måler for hver indstilling.",
      "any": [
        {
          "kind": "semantic",
          "threshold": 0.85,
          "anchors": [
            "Y er den afhængige variabel",
            "jeg måler Y for hver indstilling af X",
            "den afhængige størrelse er Y",
            "Y observerer jeg som resultat"
          ]
        },
        {
          "kind": "literal",
          "terms": ["afhængig", "afhængige"]
        }
      ]
    },
    {
      "id": "relation",
      "label": "Forudsagt sammenhæng",
      "hint": "Beskriv hvordan Y ændrer sig når X varieres (op, ned, konstant eller uafhængig).",
      "any": [
        {
          "kind": "regex",
          "pattern": "(stiger|vokser|øges|falder|aftager|proportional|konstant|større|mindre|uafhængig)",
          "flags": "iu"
        }
      ],
      "misconceptions": [
        {
          "kind": "regex",
          "pattern": "(pendul|lod|svinger)",
          "flags": "iu",
          "hint": "Beskriv en sammenhæng mellem dette forsøgs X og Y — ikke et eksempel fra et andet forsøg."
        }
      ]
    },
    {
      "id": "principle",
      "label": "Lineær form (valgfrit)",
      "required": false,
      "any": [
        {
          "kind": "semantic",
          "threshold": 0.85,
          "anchors": [
            "sammenhængen er lineær",
            "Y vokser med konstant takt",
            "der er en ret linje på grafen",
            "ligningen er på formen Y = a·X + b"
          ]
        },
        {
          "kind": "literal",
          "terms": ["lineær", "ret linje", "konstant takt"]
        }
      ]
    }
  ]
}
