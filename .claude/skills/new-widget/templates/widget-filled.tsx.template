// Canonical example: src/lab-guide/widgets/FreeTextResponse.tsx (kind:'filled' branch)
import { useRunner } from '../RunnerContext';
import { useRegisteredWidgetState } from '../useRegisteredWidgetState';
import { ProtectedTextarea } from './ProtectedInput';

interface Props {
  id: string;
  // TODO: declare authoring API (prompt, minWords, etc.).
  // TODO: add override props for student-facing strings — at minimum
  //   `placeholder` and (if minWords is used) `tooShortMessage`.
  //   Defaults must live in ../strings.da.ts (SPEC §17).
}

/**
 * __NAME__ — free-text widget.
 * Gate-compatible via { type: 'all-filled', widgetIds: ['<id>'] }.
 */
export function __NAME__({ id }: Props) {
  const { state, setWidgetValue } = useRunner();
  const value = (state.widgetValues[id] as string | undefined) ?? '';
  const filled = value.trim().length > 0;

  useRegisteredWidgetState(id, { kind: 'filled', filled }, [filled]);

  return (
    <div className="my-4">
      {/* TODO: render label, ProtectedTextarea, hints. */}
      <ProtectedTextarea
        value={value}
        onChange={(e) => setWidgetValue(id, e.target.value)}
      />
    </div>
  );
}
