import { useRunner } from '../RunnerContext';
import type { DataRow } from '../runner';

interface Props {
  id: string;
  // TODO: declare authoring API (columns, units, minRows, etc.).
}

/**
 * __NAME__ — data-collection table widget.
 *
 * Gate-compatible via { type: 'data-points', min: N }. The data-points gate
 * reads state.dataPointCount[phaseId] (phase-scoped), which is incremented by
 * simulations firing ProgressEvent('data-collected'). A pure-widget data table
 * that does NOT have an associated simulation will need a runner API (e.g.
 * incrementDataPoints) before its rows can drive the gate.
 */
export function __NAME__({ id }: Props) {
  const { state, setDataTable } = useRunner();
  const rows: DataRow[] = state.dataTables[id] ?? [];

  function setRows(next: DataRow[]) {
    setDataTable(id, next);
  }

  return (
    <div className="my-4">
      {/* TODO: render the table; on edit call setRows(...). */}
      <p className="text-sm text-slate-600">
        {/* TODO: "Målinger: {rows.length}" */}
      </p>
    </div>
  );
}
