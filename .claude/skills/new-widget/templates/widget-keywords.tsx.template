import { useEffect, useState } from 'react';
import { useRunner } from '../RunnerContext';
import { ProtectedTextarea } from './ProtectedInput';

interface Props {
  id: string;
  // TODO: declare authoring API.
  // Per SPEC §23.1, prefer keyword *groups* (any: [...]) over a flat list,
  // so students must express both a relationship concept AND a quantity concept.
  // Example shape:
  //   keywordGroups: { any: string[] }[]
}

/**
 * __NAME__ — keyword-counted free-text widget.
 * Gate-compatible via { type: 'keyword-count', widgetId: '<id>', min: N }.
 */
export function __NAME__({ id }: Props) {
  const { state, setWidgetValue, registerWidgetState, bumpAttempts } = useRunner();
  const value = (state.widgetValues[id] as string | undefined) ?? '';
  const [foundCount, setFoundCount] = useState(0);
  const [checked, setChecked] = useState(false);

  useEffect(() => {
    if (!checked) {
      registerWidgetState(id, null);
      return;
    }
    registerWidgetState(id, { kind: 'keywords', foundCount });
    return () => registerWidgetState(id, null);
  }, [id, checked, foundCount, registerWidgetState]);

  function onCheck() {
    bumpAttempts(id);
    // TODO: count satisfied keyword groups in `value` and call setFoundCount(...).
    setChecked(true);
  }

  return (
    <div className="my-4">
      <ProtectedTextarea
        value={value}
        onChange={(e) => setWidgetValue(id, e.target.value)}
      />

      {/* TODO(SPEC §13): migrate to phase-footer button registration when runner API lands. */}
      <button
        type="button"
        onClick={onCheck}
        className="mt-2 px-3 py-1.5 rounded-md bg-accent text-white text-sm"
      >
        Tjek
      </button>

      {checked && (
        <p className="mt-1 text-sm text-slate-700">
          {/* TODO: "Nøgleord fundet: {foundCount} / {total}" */}
        </p>
      )}
    </div>
  );
}
