/**
 * __ID__ — apparatus catalogue. Source of truth for the instrument enum
 * advertised in meta.ts. Rename INSTRUMENTS / InstrumentSpec / InstrumentId
 * to fit the apparatus (e.g. DYNAMOMETERS / DynamometerSpec / DynamometerId,
 * SURFACES / SurfaceSpec / SurfaceId).
 */

export interface InstrumentSpec {
  // TODO: replace with real fields, e.g. scaleMax, label, materialFriction.
  label: string;
}

export const INSTRUMENTS = {
  // TODO: e.g. 'dynamometer-1N': { scaleMax: 1, label: '1 N' },
} as const satisfies Record<string, InstrumentSpec>;

export type InstrumentId = keyof typeof INSTRUMENTS;

/** Look up an instrument spec by id; falls back to the first entry. */
export function instrumentSpec(id: string): InstrumentSpec {
  const map = INSTRUMENTS as Record<string, InstrumentSpec>;
  const fallbackKey = Object.keys(INSTRUMENTS)[0];
  return map[id] ?? (fallbackKey ? map[fallbackKey] : ({} as InstrumentSpec));
}
